<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>br.remoto</groupId>
    <artifactId>remoto-parent</artifactId>
    <version>4.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>remoto-cli</artifactId>
  <name>ReMoto :: cli</name>
  <description>Execução de cenários sem servidor (cluster/HPC), com o mesmo JSON do site</description>

  <dependencies>
    <dependency>
      <groupId>br.remoto</groupId>
      <artifactId>remoto-core</artifactId>
    </dependency>
    <dependency>
      <groupId>br.remoto</groupId>
      <artifactId>remoto-storage</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- gera um JAR executável: java -jar remoto-cli.jar run cenario.json -->
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>br.remoto.cli.RemotoCli</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
