# /etc/nginx/sites-available/remoto  (com um link em /etc/nginx/sites-enabled/)
#
# Um domínio, duas coisas — e um serviço só por trás:
#
#   /            o site descritivo — os arquivos de docs/, estáticos, que o deploy espelha
#                em /var/www/remoto (DEPLOY_SITE_DIR) e que o próprio Tomcat serve
#                (REMOTO_SITE_DIR no remoto.env)
#   /simulator/  o simulador — o Spring Boot do remoto-web, na porta 8081
#
# O nginx aqui faz o que só ele faz: o HTTPS, a compressão e o repasse. Quem decide o que
# responde em cada caminho é a aplicação, igual em desenvolvimento e no ar.
#
# O repositório não sabe em que domínio é servido: os endereços das páginas são relativos e o
# e-mail de contato sai do próprio domínio (docs/assets/site.js). Este arquivo, no servidor, é o
# único lugar em que o domínio aparece — e por isso está aqui como exemplo, com um nome qualquer.
#
# Instalação e variáveis do deploy automático: README.md, seção "Deployment".

server {
    listen 80;
    listen [::]:80;
    server_name exemplo.org www.exemplo.org;   # troque pelo seu domínio

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name exemplo.org www.exemplo.org;   # troque pelo seu domínio

    # Certificados (o certbot escreve estas duas linhas e o redirecionamento acima):
    #   sudo certbot --nginx -d exemplo.org -d www.exemplo.org
    # ssl_certificate     /etc/letsencrypt/live/exemplo.org/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/exemplo.org/privkey.pem;

    # compressão das páginas, do CSS e do JavaScript (a página inicial cai de 117 KB para ~30 KB)
    gzip on;
    gzip_proxied any;
    gzip_types text/css application/javascript text/javascript image/svg+xml application/json;

    # Importar cenários (.json/.zip) e simulações (.zip): ver spring.servlet.multipart.
    client_max_body_size 500m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # o actuator é interno: fica acessível na máquina (é o que o deploy consulta), não de fora
    location /simulator/actuator {
        return 404;
    }

    # O Tomcat também redireciona /simulator para /simulator/, mas sem o X-Forwarded-Proto
    # (SERVER_FORWARD_HEADERS_STRATEGY) o endereço dele sairia em http, e o navegador faria uma
    # volta a mais; aqui o redirecionamento já sai certo.
    location = /simulator {
        return 301 /simulator/;
    }

    # ---- o simulador ----
    # O app roda com context-path /simulator (application.yml), então o caminho segue inteiro:
    # proxy_pass sem caminho nenhum, para o nginx não reescrever nada.
    location /simulator/ {
        proxy_pass http://127.0.0.1:8081;

        # O progresso das simulações vai por SSE (/simulator/api/runs/{id}/events): sem buffer,
        # senão o navegador só recebe no fim, e sem timeout curto, que cortaria a conexão.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    # ---- o site descritivo ----
    # Páginas estáticas, servidas pelo mesmo Tomcat (um segundo contexto, na raiz). Aqui o buffer
    # fica ligado, que é o melhor para arquivo.
    location / {
        proxy_pass http://127.0.0.1:8081;
    }
}

# Para o app enxergar o endereço de quem acessa (o limite de simulações por origem) e o endereço
# público, descomente SERVER_FORWARD_HEADERS_STRATEGY=native no /etc/remoto/remoto.env. Sem isso,
# todo mundo chega com o endereço do proxy.
