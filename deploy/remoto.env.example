# Copie para /etc/remoto/remoto.env com permissão 600:
#   sudo install -D -m 600 deploy/remoto.env.example /etc/remoto/remoto.env

# A porta do simulador, atrás do proxy reverso. A 8081 é o padrão do application.yml (a 8080
# costuma estar ocupada por outro serviço); aqui ela fica explícita, para ser fácil de mudar.
# Para o app escutar só em loopback, e só o proxy atender a internet: SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8081
REMOTO_DATA_DIR=/var/lib/remoto
REMOTO_PUBLIC_SCENARIOS_DIR=/opt/remoto/scenarios

# As páginas do site descritivo, que o próprio Tomcat serve na raiz do domínio (o simulador fica
# em /simulator). É a pasta que o deploy espelha, a DEPLOY_SITE_DIR do GitHub; o usuário do
# serviço só precisa poder ler. Sem esta linha a raiz fica sem nada e só o simulador responde.
REMOTO_SITE_DIR=/var/www/remoto

# O endereço de contato que as páginas do site mostram. Sem esta linha, o site monta
# remoto@<domínio> a partir do domínio em que está servido — que é o que ele sempre fez, e serve
# a maior parte das instalações. Decida ao instalar:
#   - deixe comentado para manter o endereço deduzido do domínio;
#   - preencha com outro endereço se a caixa postal do seu domínio não for essa;
#   - preencha com uma caixa que você leia, se for publicar o site para outras pessoas.
# Não há como apagar o endereço por aqui: se preferir não publicar nenhum, tire o bloco de
# contato das páginas (docs/index.html e docs/pt/index.html), que ficam só com as issues.
# REMOTO_CONTACT_EMAIL=remoto@exemplo.br

# Onde o simulador fica dentro do domínio. O padrão é /simulator (application.yml), com o site
# descritivo na raiz; o nginx repassa esse caminho sem reescrever (ver nginx-remoto.conf.example).
# SERVER_SERVLET_CONTEXT_PATH=/simulator

# Os idiomas das páginas, na ordem: o primeiro é o padrão e fica na raiz do simulador, e cada um
# dos outros ganha uma porta de entrada (/simulator/pt). Um idioma novo precisa do seu
# messages_<código>.properties no JAR.
# REMOTO_LANGUAGES=en,pt

# Memória da JVM (fração da RAM do servidor) e outras opções do Java.
JAVA_OPTS=-XX:MaxRAMPercentage=50

# Simulações em paralelo (padrão: número de núcleos da CPU).
# REMOTO_SIMULATION_SLOTS=8

# Threads do motor original em cada simulação (padrão: núcleos ÷ slots). Não muda o resultado.
# REMOTO_SIMULATION_THREADS_PER_RUN=4

# Atrás de nginx/Apache com HTTPS, descomente para o app enxergar o endereço público e o
# endereço de quem acessa (usado no limite de simulações por origem).
# SERVER_FORWARD_HEADERS_STRATEGY=native

# Não há login: cada navegador tem sua área, identificada por um cookie. Depois de tantos dias
# sem uso, o cookie expira e a área é apagada.
# REMOTO_RETENTION_AREA_DAYS=30

# Limites da fila: por endereço de origem (somando as áreas) e no total (0 = sem limite).
# REMOTO_SIMULATION_MAX_PER_ORIGIN=20
# REMOTO_SIMULATION_MAX_QUEUED_TOTAL=200

# Teto do disco (0 = sem limite, o padrão). Num servidor aberto vale pôr os dois: o por área
# segura quem exagera de boa-fé, e o total protege a máquina de quem não está, já que sem login
# um cookie novo é uma área nova. Valores de referência para uma máquina pequena:
REMOTO_STORAGE_MAX_AREA_BYTES=500MB
REMOTO_STORAGE_MAX_TOTAL_BYTES=5GB

# Escritas da API por minuto do mesmo endereço (0 = sem limite). É o que as cotas por área não
# dão: um cookie novo é uma área nova, mas o endereço é o mesmo. Um humano no simulador não
# chega perto disto; um script chega na primeira dúzia de segundos.
REMOTO_LIMITS_API_WRITES_PER_MINUTE=60
