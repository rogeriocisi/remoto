# Copie para /etc/remoto/remoto.env com permissão 600:
#   sudo install -D -m 600 deploy/remoto.env.example /etc/remoto/remoto.env

SERVER_PORT=8080
REMOTO_DATA_DIR=/var/lib/remoto
REMOTO_PUBLIC_SCENARIOS_DIR=/opt/remoto/scenarios

# Memória da JVM (fração da RAM do servidor) e outras opções do Java.
JAVA_OPTS=-XX:MaxRAMPercentage=50

# Simulações em paralelo (padrão: número de núcleos da CPU).
# REMOTO_SIMULATION_SLOTS=8

# Threads do motor original em cada simulação (padrão: núcleos ÷ slots). Não muda o resultado.
# REMOTO_SIMULATION_THREADS_PER_RUN=4

# Atrás de nginx/Apache com HTTPS, descomente para o app enxergar o endereço público e o
# endereço de quem acessa (usado no limite de simulações por origem).
# SERVER_FORWARD_HEADERS_STRATEGY=native

# Não há login: cada navegador tem sua área, identificada por um cookie. Depois de tantos dias
# sem uso, o cookie expira e a área é apagada.
# REMOTO_RETENTION_AREA_DAYS=30

# Limites da fila: por endereço de origem (somando as áreas) e no total (0 = sem limite).
# REMOTO_SIMULATION_MAX_PER_ORIGIN=20
# REMOTO_SIMULATION_MAX_QUEUED_TOTAL=200
