<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>br.remoto</groupId>
    <artifactId>remoto-parent</artifactId>
    <version>3.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>remoto-legacy</artifactId>
  <name>ReMoto :: legacy engine</name>
  <description>
    Liga os modelos originais (remoto-legacy-model) à nova plataforma: exporta as configurações
    do HSQLDB antigo para JSON e roda o motor original como um SimulationEngine.
  </description>

  <dependencies>
    <dependency>
      <groupId>br.remoto</groupId>
      <artifactId>remoto-core</artifactId>
    </dependency>
    <dependency>
      <groupId>br.remoto</groupId>
      <artifactId>remoto-legacy-model</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <dependency>
      <groupId>br.remoto</groupId>
      <artifactId>remoto-storage</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- os testes leem o banco legado em WebContent/db -->
          <systemPropertyVariables>
            <remoto.legacy.db>${project.basedir}/../WebContent/db/remoto</remoto.legacy.db>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
