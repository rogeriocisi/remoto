<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Nova versão do ReMoto (Java 25 + Spring Boot 4, sem banco de dados).
    Os modelos do ReMoto original foram portados para o remoto-core, com saídas idênticas bit a
    bit; do código legado fica só o banco HSQLDB original em legacy-db/, um arquivo de texto que o
    export-legacy lê sem o HSQLDB. O site Struts/JSP e o código original estão no histórico do
    Git e no repositório pai.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>br.remoto</groupId>
  <artifactId>remoto-parent</artifactId>
  <version>3.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>ReMoto</name>
  <description>Simulador de núcleos motores da medula espinhal (nova versão, sem banco de dados)</description>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <modules>
    <module>remoto-core</module>
    <module>remoto-storage</module>
    <module>remoto-web</module>
    <module>remoto-cli</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <picocli.version>4.7.7</picocli.version>
    <jfreechart.version>1.5.6</jfreechart.version>
    <!--
      "mvnw -pl remoto-web -am spring-boot:run" roda o goal em todos os módulos da lista;
      só o remoto-web tem aplicação para subir, os outros pulam.
    -->
    <spring-boot.run.skip>true</spring-boot.run.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>br.remoto</groupId>
        <artifactId>remoto-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>br.remoto</groupId>
        <artifactId>remoto-storage</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jfree</groupId>
        <artifactId>jfreechart</artifactId>
        <version>${jfreechart.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
