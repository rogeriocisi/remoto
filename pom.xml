<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Nova versão do ReMoto (Java 25 + Spring Boot 4, sem banco de dados).
    O código legado (src/ e WebContent/, Struts 1 + Tomcat 7) continua intacto
    e é ignorado por este build; ele será substituído aos poucos.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>br.remoto</groupId>
  <artifactId>remoto-parent</artifactId>
  <version>3.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>ReMoto</name>
  <description>Simulador de núcleos motores da medula espinhal (nova versão, sem banco de dados)</description>

  <modules>
    <module>remoto-core</module>
    <module>remoto-storage</module>
    <module>remoto-legacy-model</module>
    <module>remoto-legacy</module>
    <module>remoto-web</module>
    <module>remoto-cli</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <picocli.version>4.7.7</picocli.version>
    <jfreechart.version>1.5.6</jfreechart.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>br.remoto</groupId>
        <artifactId>remoto-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>br.remoto</groupId>
        <artifactId>remoto-storage</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>br.remoto</groupId>
        <artifactId>remoto-legacy-model</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>br.remoto</groupId>
        <artifactId>remoto-legacy</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jfree</groupId>
        <artifactId>jfreechart</artifactId>
        <version>${jfreechart.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
