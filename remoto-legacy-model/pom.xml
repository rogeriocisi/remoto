<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>br.remoto</groupId>
    <artifactId>remoto-parent</artifactId>
    <version>3.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>remoto-legacy-model</artifactId>
  <name>ReMoto :: legacy model</name>
  <description>
    Os modelos numéricos originais do ReMoto (br.remoto.model e dependências), trazidos do
    src/ do repositório pai sem alteração numérica. Só ficaram as classes alcançáveis a partir
    de Simulation, ConfigurationDAO e Rng; Struts, JSPs e applets foram removidos.
  </description>

  <properties>
    <!-- o código legado está em ISO-8859-1 -->
    <project.build.sourceEncoding>ISO-8859-1</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.hsqldb</groupId>
      <artifactId>hsqldb</artifactId>
    </dependency>
    <!-- algumas classes do modelo ainda referenciam br.remoto.servlet.SpindleSimulation -->
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>javax.servlet-api</artifactId>
      <version>3.1.0</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <arg>-nowarn</arg>
            <arg>-Xlint:none</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
